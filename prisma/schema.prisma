generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Role {
  role_id   Int        @id
  role_name String     @unique @db.VarChar(80)
  employees Employee[]

  @@map("roles")
}

model Department {
  department_id   Int        @id
  department_name String     @unique @db.VarChar(80)
  employees       Employee[]

  @@map("departments")
}

model EmployeeStatus {
  status_id   Int        @id
  status_name String     @unique @db.VarChar(40)
  employees   Employee[]

  @@map("employee_statuses")
}

model StoreType {
  store_type_id Int     @id
  type_name     String  @unique @db.VarChar(60)
  stores        Store[]

  @@map("store_types")
}

model Province {
  province_id   Int      @id
  province_name String   @unique @db.VarChar(100)
  cities        City[]

  @@map("provinces")
}

model City {
  city_id     Int        @id
  province_id Int
  city_name   String     @db.VarChar(100)
  province    Province   @relation(fields: [province_id], references: [province_id])
  districts   District[]
  suppliers   Supplier[]

  @@map("cities")
}

model District {
  district_id   Int        @id
  city_id       Int
  district_name String     @db.VarChar(100)
  city          City       @relation(fields: [city_id], references: [city_id])
  stores        Store[]
  customers     Customer[]

  @@map("districts")
}

model Store {
  store_id       Int      @id
  store_code     String   @unique @db.VarChar(20)
  store_name     String   @db.VarChar(120)
  store_type_id  Int
  district_id    Int
  address        String   @db.VarChar(255)
  phone          String?  @db.VarChar(30)
  opening_date   DateTime? @db.Date
  store_type     StoreType @relation(fields: [store_type_id], references: [store_type_id])
  district       District  @relation(fields: [district_id], references: [district_id])
  employees      Employee[]
  employee_shifts EmployeeShift[]
  product_stock  ProductStock[]
  purchase_orders PurchaseOrder[]
  goods_receipts GoodsReceipt[]
  sales_orders   SalesOrder[]
  inventory_adjustments InventoryAdjustment[]
  expenses       Expense[]
  daily_cash_reconciliations DailyCashReconciliation[]

  @@map("stores")
}

model Shift {
  shift_id        Int             @id
  shift_name      String          @db.VarChar(50)
  start_time      DateTime        @db.Time
  end_time        DateTime        @db.Time
  employee_shifts EmployeeShift[]

  @@map("shifts")
}

model Employee {
  employee_id     Int              @id
  store_id        Int
  role_id         Int
  department_id   Int
  status_id       Int
  employee_code   String           @unique @db.VarChar(20)
  full_name       String           @db.VarChar(120)
  gender          String?          @db.VarChar(20)
  hire_date       DateTime?        @db.Date
  salary          Decimal?         @db.Decimal(12, 2)
  store           Store            @relation(fields: [store_id], references: [store_id])
  role            Role             @relation(fields: [role_id], references: [role_id])
  department      Department       @relation(fields: [department_id], references: [department_id])
  status          EmployeeStatus   @relation(fields: [status_id], references: [status_id])
  employee_shifts EmployeeShift[]
  purchase_orders PurchaseOrder[]
  goods_receipts  GoodsReceipt[]
  sales_orders    SalesOrder[]     @relation("Cashier")
  inventory_adjustments InventoryAdjustment[]
  returns_handled Return[]         @relation("HandledBy")
  daily_cash_reconciliations DailyCashReconciliation[]

  @@map("employees")
}

model EmployeeShift {
  employee_shift_id Int      @id
  employee_id       Int
  store_id          Int
  shift_id          Int
  work_date         DateTime @db.Date
  note              String?  @db.VarChar(120)
  employee          Employee @relation(fields: [employee_id], references: [employee_id])
  store             Store    @relation(fields: [store_id], references: [store_id])
  shift             Shift    @relation(fields: [shift_id], references: [shift_id])

  @@map("employee_shifts")
}

model Supplier {
  supplier_id   Int      @id
  supplier_code String   @unique @db.VarChar(20)
  supplier_name String   @db.VarChar(150)
  contact_name  String?  @db.VarChar(100)
  phone         String?  @db.VarChar(30)
  email         String?  @db.VarChar(120)
  address       String?  @db.VarChar(255)
  city_id       Int
  city          City     @relation(fields: [city_id], references: [city_id])
  products      Product[]
  purchase_orders PurchaseOrder[]

  @@map("suppliers")
}

model Unit {
  unit_id      Int       @id
  unit_name    String    @db.VarChar(60)
  abbreviation String    @db.VarChar(15)
  products     Product[]

  @@map("units")
}

model ProductCategory {
  category_id   Int                  @id
  category_name String               @unique @db.VarChar(100)
  subcategories ProductSubcategory[]
  products      Product[]

  @@map("product_categories")
}

model ProductSubcategory {
  subcategory_id   Int             @id
  category_id      Int
  subcategory_name String          @db.VarChar(100)
  category         ProductCategory @relation(fields: [category_id], references: [category_id])
  products         Product[]

  @@map("product_subcategories")
}

model Brand {
  brand_id   Int       @id
  brand_name String    @unique @db.VarChar(100)
  products   Product[]

  @@map("brands")
}

model Product {
  product_id      Int                @id
  sku             String             @unique @db.VarChar(30)
  product_name    String             @db.VarChar(160)
  category_id     Int
  subcategory_id  Int
  brand_id        Int
  unit_id         Int
  supplier_id     Int
  cost_price      Decimal            @db.Decimal(12, 2)
  retail_price    Decimal            @db.Decimal(12, 2)
  is_active       Boolean            @default(true)
  category        ProductCategory    @relation(fields: [category_id], references: [category_id])
  subcategory     ProductSubcategory @relation(fields: [subcategory_id], references: [subcategory_id])
  brand           Brand              @relation(fields: [brand_id], references: [brand_id])
  unit            Unit               @relation(fields: [unit_id], references: [unit_id])
  supplier        Supplier           @relation(fields: [supplier_id], references: [supplier_id])
  barcodes        ProductBarcode[]
  prices          ProductPrice[]
  stock           ProductStock[]
  purchase_order_items PurchaseOrderItem[]
  goods_receipt_items  GoodsReceiptItem[]
  sales_order_items    SalesOrderItem[]
  promotion_products   PromotionProduct[]
  inventory_adjustments InventoryAdjustment[]
  return_items    ReturnItem[]

  @@map("products")
}

model ProductBarcode {
  barcode_id Int     @id
  product_id Int
  barcode    String  @unique @db.VarChar(40)
  product    Product @relation(fields: [product_id], references: [product_id])

  @@map("product_barcodes")
}

model ProductPrice {
  price_id       Int      @id
  product_id     Int
  effective_date DateTime @db.Date
  price          Decimal  @db.Decimal(12, 2)
  cost_price     Decimal  @db.Decimal(12, 2)
  product        Product  @relation(fields: [product_id], references: [product_id])

  @@map("product_prices")
}

model ProductStock {
  stock_id      Int      @id
  store_id      Int
  product_id    Int
  qty_on_hand   Int
  reorder_level Int
  last_updated  DateTime?
  store         Store    @relation(fields: [store_id], references: [store_id])
  product       Product  @relation(fields: [product_id], references: [product_id])

  @@unique([store_id, product_id])
  @@map("product_stock")
}

model PurchaseOrder {
  po_id         Int               @id
  po_number     String            @unique @db.VarChar(30)
  supplier_id   Int
  store_id      Int
  employee_id   Int
  order_date    DateTime          @db.Date
  expected_date DateTime?         @db.Date
  status        String            @db.VarChar(40)
  supplier      Supplier          @relation(fields: [supplier_id], references: [supplier_id])
  store         Store             @relation(fields: [store_id], references: [store_id])
  employee      Employee          @relation(fields: [employee_id], references: [employee_id])
  items         PurchaseOrderItem[]
  goods_receipts GoodsReceipt[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  po_item_id Int           @id
  po_id      Int
  product_id Int
  quantity   Int
  unit_cost  Decimal       @db.Decimal(12, 2)
  po         PurchaseOrder @relation(fields: [po_id], references: [po_id])
  product    Product       @relation(fields: [product_id], references: [product_id])

  @@map("purchase_order_items")
}

model GoodsReceipt {
  receipt_id    Int              @id
  gr_number     String           @unique @db.VarChar(30)
  po_id         Int
  store_id      Int
  received_by   Int
  received_date DateTime         @db.Date
  status        String           @db.VarChar(40)
  po            PurchaseOrder    @relation(fields: [po_id], references: [po_id])
  store         Store            @relation(fields: [store_id], references: [store_id])
  employee      Employee         @relation(fields: [received_by], references: [employee_id])
  items         GoodsReceiptItem[]

  @@map("goods_receipts")
}

model GoodsReceiptItem {
  gr_item_id        Int          @id
  receipt_id        Int
  product_id        Int
  quantity_received Int
  unit_cost         Decimal      @db.Decimal(12, 2)
  receipt           GoodsReceipt @relation(fields: [receipt_id], references: [receipt_id])
  product           Product      @relation(fields: [product_id], references: [product_id])

  @@map("goods_receipt_items")
}

model MembershipTier {
  tier_id          Int          @id
  tier_name        String       @unique @db.VarChar(60)
  min_points       Int
  discount_percent Decimal      @db.Decimal(5, 2)
  memberships      Membership[]

  @@map("membership_tiers")
}

model Customer {
  customer_id   Int         @id
  customer_code String      @unique @db.VarChar(30)
  full_name     String      @db.VarChar(120)
  gender        String?     @db.VarChar(20)
  phone         String?     @db.VarChar(30)
  email         String?     @db.VarChar(120)
  birth_date    DateTime?   @db.Date
  district_id   Int?
  registered_at DateTime?
  district      District?   @relation(fields: [district_id], references: [district_id])
  membership    Membership?
  sales_orders  SalesOrder[]
  returns       Return[]
  coupons       Coupon[]

  @@map("customers")
}

model Membership {
  membership_id Int            @id
  customer_id   Int            @unique
  tier_id       Int
  member_no     String         @unique @db.VarChar(30)
  joined_date   DateTime       @db.Date
  points        Int            @default(0)
  status        String         @db.VarChar(30)
  customer      Customer       @relation(fields: [customer_id], references: [customer_id])
  tier          MembershipTier @relation(fields: [tier_id], references: [tier_id])

  @@map("memberships")
}

model Promotion {
  promotion_id    Int                @id
  promo_code      String             @unique @db.VarChar(30)
  promo_name      String             @db.VarChar(120)
  start_date      DateTime           @db.Date
  end_date        DateTime           @db.Date
  discount_type   String             @db.VarChar(20)
  discount_value  Decimal            @db.Decimal(12, 2)
  promotion_products PromotionProduct[]
  coupons         Coupon[]
  sales_order_items SalesOrderItem[]

  @@map("promotions")
}

model PromotionProduct {
  promo_product_id Int       @id
  promotion_id     Int
  product_id       Int
  promotion        Promotion @relation(fields: [promotion_id], references: [promotion_id])
  product          Product   @relation(fields: [product_id], references: [product_id])

  @@unique([promotion_id, product_id])
  @@map("promotion_products")
}

model Coupon {
  coupon_id    Int       @id
  customer_id  Int
  promotion_id Int
  coupon_code  String    @unique @db.VarChar(40)
  issued_date  DateTime  @db.Date
  expired_date DateTime  @db.Date
  is_used      Boolean   @default(false)
  customer     Customer  @relation(fields: [customer_id], references: [customer_id])
  promotion    Promotion @relation(fields: [promotion_id], references: [promotion_id])

  @@map("coupons")
}

model PaymentMethod {
  method_id   Int       @id
  method_name String    @unique @db.VarChar(60)
  payments    Payment[]

  @@map("payment_methods")
}

model SalesOrder {
  sale_id        Int              @id
  invoice_number String           @unique @db.VarChar(40)
  store_id       Int
  customer_id    Int?
  cashier_id     Int
  sale_datetime  DateTime
  subtotal       Decimal          @db.Decimal(14, 2)
  discount_total Decimal          @db.Decimal(14, 2)
  tax_total      Decimal          @db.Decimal(14, 2)
  grand_total    Decimal          @db.Decimal(14, 2)
  status         String           @db.VarChar(30)
  store          Store            @relation(fields: [store_id], references: [store_id])
  customer       Customer?        @relation(fields: [customer_id], references: [customer_id])
  cashier        Employee         @relation("Cashier", fields: [cashier_id], references: [employee_id])
  items          SalesOrderItem[]
  payments       Payment[]
  returns        Return[]

  @@map("sales_orders")
}

model SalesOrderItem {
  sale_item_id    Int        @id
  sale_id         Int
  product_id      Int
  promo_id        Int?
  quantity        Int
  unit_price      Decimal    @db.Decimal(12, 2)
  discount_amount Decimal    @default(0) @db.Decimal(12, 2)
  line_total      Decimal    @db.Decimal(14, 2)
  sale            SalesOrder @relation(fields: [sale_id], references: [sale_id])
  product         Product    @relation(fields: [product_id], references: [product_id])
  promotion       Promotion? @relation(fields: [promo_id], references: [promotion_id])
  return_items    ReturnItem[]

  @@map("sales_order_items")
}

model Payment {
  payment_id   Int           @id
  sale_id      Int
  method_id    Int
  paid_amount  Decimal       @db.Decimal(14, 2)
  payment_time DateTime
  reference_no String?       @db.VarChar(60)
  status       String        @db.VarChar(30)
  sale         SalesOrder    @relation(fields: [sale_id], references: [sale_id])
  method       PaymentMethod @relation(fields: [method_id], references: [method_id])

  @@map("payments")
}

model ReturnReason {
  reason_id   Int      @id
  reason_name String   @unique @db.VarChar(100)
  returns     Return[]

  @@map("return_reasons")
}

model Return {
  return_id     Int          @id
  sale_id       Int
  customer_id   Int?
  handled_by    Int
  return_date   DateTime
  reason_id     Int
  refund_amount Decimal      @db.Decimal(14, 2)
  status        String       @db.VarChar(30)
  sale          SalesOrder   @relation(fields: [sale_id], references: [sale_id])
  customer      Customer?    @relation(fields: [customer_id], references: [customer_id])
  handler       Employee     @relation("HandledBy", fields: [handled_by], references: [employee_id])
  reason        ReturnReason @relation(fields: [reason_id], references: [reason_id])
  items         ReturnItem[]

  @@map("returns")
}

model ReturnItem {
  return_item_id Int            @id
  return_id      Int
  sale_item_id   Int
  product_id     Int
  quantity       Int
  refund_amount  Decimal        @db.Decimal(14, 2)
  return         Return         @relation(fields: [return_id], references: [return_id])
  sale_item      SalesOrderItem @relation(fields: [sale_item_id], references: [sale_item_id])
  product        Product        @relation(fields: [product_id], references: [product_id])

  @@map("return_items")
}

model InventoryAdjustment {
  adjustment_id   Int      @id
  store_id        Int
  product_id      Int
  employee_id     Int
  adjustment_date DateTime
  qty_change      Int
  reason          String   @db.VarChar(80)
  note            String?  @db.VarChar(160)
  store           Store    @relation(fields: [store_id], references: [store_id])
  product         Product  @relation(fields: [product_id], references: [product_id])
  employee        Employee @relation(fields: [employee_id], references: [employee_id])

  @@map("inventory_adjustments")
}

model Expense {
  expense_id       Int      @id
  store_id         Int
  expense_date     DateTime @db.Date
  expense_category String   @db.VarChar(80)
  amount           Decimal  @db.Decimal(14, 2)
  description      String?  @db.VarChar(160)
  store            Store    @relation(fields: [store_id], references: [store_id])

  @@map("expenses")
}

model DailyCashReconciliation {
  recon_id      Int      @id
  store_id      Int
  recon_date    DateTime @db.Date
  opening_cash  Decimal  @db.Decimal(14, 2)
  cash_sales    Decimal  @db.Decimal(14, 2)
  cash_refunds  Decimal  @db.Decimal(14, 2)
  expected_cash Decimal  @db.Decimal(14, 2)
  actual_cash   Decimal  @db.Decimal(14, 2)
  variance      Decimal  @db.Decimal(14, 2)
  checked_by    Int
  store         Store    @relation(fields: [store_id], references: [store_id])
  checker       Employee @relation(fields: [checked_by], references: [employee_id])

  @@map("daily_cash_reconciliations")
}
